<?xml version="1.0" encoding="utf-8"?>
<!-- Shift key while active (Keyboard.setShifted marks it state_checked) —
     an accent tint, the same way Gboard highlights an active shift key. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="2dp" android:insetRight="2dp"
    android:insetTop="3dp" android:insetBottom="3dp">
    <layer-list>
        <item android:top="2dp">
            <shape android:shape="rectangle">
                <solid android:color="#4d000000" />
                <corners android:radius="12dp" />
            </shape>
        </item>
        <item android:bottom="2dp">
            <shape android:shape="rectangle">
                <solid android:color="#4a6fa5" />
                <corners android:radius="12dp" />
            </shape>
        </item>
    </layer-list>
</inset>
