<?xml version="1.0" encoding="utf-8"?>
<!-- Inset (not Keyboard-level horizontalGap/verticalGap) creates the visual
     gap between keys — gap attributes add to each row's total width/height
     on top of percentages that already sum to 100%, overflowing the screen. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="2dp" android:insetRight="2dp"
    android:insetTop="3dp" android:insetBottom="3dp">
    <shape android:shape="rectangle">
        <solid android:color="#3a3a3c" />
        <corners android:radius="10dp" />
    </shape>
</inset>
